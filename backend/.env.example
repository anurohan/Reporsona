# ---- App ----
APP_NAME=RePersona
ENV=development
DEBUG=true
# DEMO_MODE only controls whether a ready "Osho" demo persona is seeded at
# startup (offline). It no longer forces demo answers or demo sources.
DEMO_MODE=true

# ---- Source discovery ----
# auto | wikipedia : collect REAL public data live from Wikipedia/Wikiquote/
#                    Wikimedia (no API key, legal, portrait image included).
# demo             : only use the bundled synthetic corpus (fully offline).
SOURCE_MODE=auto
WIKIPEDIA_LANG=en

# ---- Database ----
# Default SQLite requires no server. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://repersona:repersona@localhost:5432/repersona
DATABASE_URL=sqlite:///./repersona.db

# ---- CORS (comma-separated) ----
CORS_ORIGINS=http://localhost:3000

# ---- LLM (Llama) ----
# auto              : use Ollama if it is reachable, else the offline composer.
# demo              : always use the offline composer (no LLM server).
# ollama            : require Ollama at LLM_BASE_URL.
# openai_compatible : any OpenAI-compatible /v1/chat/completions endpoint.
LLM_PROVIDER=auto
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=llama3.2:3b
LLM_API_KEY=
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=768

# ---- Embeddings ----
# Falls back to an offline lexical embedder if sentence-transformers is absent.
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# ---- Vector store: faiss | memory (auto-falls back to memory) ----
VECTOR_DB=faiss
VECTOR_DIR=./data/vector

# ---- Whisper (speech-to-text) ----
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# ---- Storage: local | s3 ----
STORAGE_BACKEND=local
STORAGE_DIR=./data/storage
S3_BUCKET=
S3_ENDPOINT_URL=

# ---- Workers / queue (optional) ----
REDIS_URL=

# ---- Extra source discovery (optional, authorised APIs only) ----
# RePersona never scrapes or bypasses paywalls/robots/access controls. These
# providers are OPTIONAL: leave blank to run purely on Wikipedia/Wikiquote.
# When a key is absent the provider is skipped and reported as "not configured"
# on the Settings → Providers panel (§27) — nothing is faked.
#
# Live web search (§6): "" (disabled) | "tavily" | "serpapi"
#   Tavily:  https://app.tavily.com  (SEARCH_API_KEY = your Tavily key)
#   SerpAPI: https://serpapi.com/manage-api-key
SEARCH_PROVIDER=
SEARCH_API_KEY=

# YouTube Data API v3 (§7) — discovers documented interviews/talks. Without a
# key, YouTube discovery is skipped (never fabricated).
#   Get a key: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# News API (optional current-context enrichment, §19).
#   Get a key: https://newsapi.org/register
NEWS_API_KEY=

# ---- Limits ----
MAX_QUESTION_CHARS=2000
RATE_LIMIT_PER_MINUTE=60
