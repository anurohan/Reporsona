# Root convenience env. The backend reads backend/.env (see backend/.env.example)
# and the frontend reads frontend/.env.local (NEXT_PUBLIC_API_BASE).
# Most commonly changed values:

# --- Backend ---
DEMO_MODE=true                # seeds an offline "Osho" demo persona at startup
SOURCE_MODE=auto              # auto/wikipedia = live real data; demo = offline only
WIKIPEDIA_LANG=en
LLM_PROVIDER=auto             # auto | demo | ollama | openai_compatible
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=llama3.2:3b
DATABASE_URL=sqlite:///./repersona.db
VECTOR_DB=faiss               # faiss | memory
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# --- Frontend ---
NEXT_PUBLIC_API_BASE=http://localhost:8000

# --- Optional external providers (leave blank to run on Wikipedia only) ---
# See backend/.env.example for full docs + signup links. Missing keys are
# reported as "not configured" on Settings → Providers; nothing is faked.
SEARCH_PROVIDER=          # "" | tavily | serpapi   (live web search, §6)
SEARCH_API_KEY=           # Tavily/SerpAPI key
YOUTUBE_API_KEY=          # YouTube Data API v3 (interview discovery, §7)
NEWS_API_KEY=             # NewsAPI (current-context enrichment, §19)
